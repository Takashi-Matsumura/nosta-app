# ローカル PostgreSQL（docker-compose.yml）への接続文字列
DATABASE_URL=postgres://nosta:nosta@localhost:5434/nosta

# 学校の Google Workspace ドメイン。このドメインのメールアドレスだけログインを許可する
ALLOWED_EMAIL_DOMAIN=your-school.example

# NextAuth (Auth.js) のセッション署名用シークレット。`openssl rand -base64 32` で生成する
AUTH_SECRET=

# Google Cloud Console > API とサービス > 認証情報 で発行する OAuth クライアント。
# 承認済みのリダイレクト URI に http://localhost:3000/api/auth/callback/google を追加する
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
